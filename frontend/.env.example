# Base URL of the backend API.
# Local dev: http://localhost:4000/api
# Live deploy: https://your-backend-domain.com/api
VITE_API_URL=http://localhost:4000/api

# Google OAuth Client ID (same project as backend/.env's GOOGLE_CLIENT_ID)
# Leave empty to fall back to the "Continue with Google (Demo)" button,
# which calls POST /api/auth/demo instead of real Google sign-in.
VITE_GOOGLE_CLIENT_ID=
